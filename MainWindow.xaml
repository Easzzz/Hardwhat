        <!-- 原内部 Grid 横跨两列，保持按钮居中 -->
        <Grid x:Name="InnerGrid" Grid.ColumnSpan="3" Margin="0,0,0,-1">
            <Button x:Name="ToSearch" Content="Click to search"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="284" Height="70" FontSize="24"
                    FontFamily="975 圆体" BorderThickness="8,8,8,8"
                    Click="ToSearch_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="6"
                                Background="#181C26"
                                BorderBrush="#2E3548"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Foreground" Value="#C5CBD6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#282F40"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3E4862"/>
                                <Setter Property="Foreground" Value="#E2E6ED"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333843"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#495165"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Label x:Name="Welcome" Content="" 
                   HorizontalAlignment="Center" 
                   Margin="0,118,0,0" 
                   VerticalAlignment="Top" 
                   Height="85" Width="446" 
                   FontSize="36" 
                   Foreground="#FFC5CBD6" 
                   HorizontalContentAlignment="Center" 
                   VerticalContentAlignment="Center" 
                   FontFamily="975 圆体"/>
        </Grid>
        <Button x:Name="Export" Content="Button" HorizontalAlignment="Center" Height="38" VerticalAlignment="Bottom" Width="38" RenderTransformOrigin="0.123,0.748" Margin="2,0,0,6" Click="Export_Click" Visibility="Hidden">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="8, 7, 7, 7">
                    <Path x:Name="icon" Stretch="Uniform"
                                      Stroke="#8A90A2" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 6,22 A 2,2 0 0 1 4,20 V 4 A 2,2 0 0 1 6,2 H 14 A 2.4,2.4 0 0 1 15.704,2.706 L 19.292,6.294 A 2.4,2.4 0 0 1 20,8 V 20 A 2,2 0 0 1 18,22 Z M 14,2 V 7 A 1,1 0 0 0 15,8 H 20 M 12,12 V 18 M 15,15 L 12,12 L 9,15"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="border" Property="Background" Value="#282F40"/>
                        <Setter TargetName="icon" Property="Stroke" Value="#E2E6ED"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="border" Property="Background" Value="#333843"/>
                        <Setter TargetName="icon" Property="Stroke" Value="#FFFFFF"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
     </Button>
    </Grid>
</Window>