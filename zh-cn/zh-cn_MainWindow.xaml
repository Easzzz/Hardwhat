        <Grid x:Name="InnerGrid" Grid.ColumnSpan="3" Margin="0,0,0,-1">
            <Button x:Name="ToSearch" Content="点击搜索硬件信息"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="284" Height="70" FontSize="24"
                    FontFamily="975 圆体" BorderThickness="8,8,8,8"
                    Click="ToSearch_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="6"
                                Background="#181C26"
                                BorderBrush="#2E3548"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Foreground" Value="#C5CBD6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#282F40"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3E4862"/>
                                <Setter Property="Foreground" Value="#E2E6ED"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333843"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#495165"/>
                                <Setter Property="Foreground" Value="#E2E6ED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
