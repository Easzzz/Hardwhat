<Window x:Class="Hardwhat.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hardwhat"
        mc:Ignorable="d"
        Title="ExportDialog" Width="412" Height="259" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#C5CBD6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                            CornerRadius="8"
                            Background="#181C26"
                            BorderBrush="#2E3548"
                            BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#282F40"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3E4862"/>
                                <Setter Property="Foreground" Value="#E2E6ED"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333843"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#495165"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#FF0F1117">
        <Button x:Name="AsTableMd"
        Content="Export as Table Markdown"
        Style="{StaticResource DarkButtonStyle}"
        HorizontalAlignment="Left" VerticalAlignment="Top"
        Height="50" Width="182
                "
        Margin="15,94,0,0"
        Click="AsTableMd_Click" FontFamily="Microsoft Sans Serif"/>

        <Button x:Name="AsCsv"
        Content="Export as CSV"
        Style="{StaticResource DarkButtonStyle}"
        HorizontalAlignment="Left" VerticalAlignment="Top"
        Height="50" Width="182
                "
        Margin="15,154,0,0" Click="AsCsv_Click" FontFamily="Microsoft Sans Serif"/>

        <Button x:Name="AsHeadingMarkdown"
        Content="Export as Heading Markdown"
        Style="{StaticResource DarkButtonStyle}"
        HorizontalAlignment="Left" VerticalAlignment="Top"
        Height="50" Width="182"
        Margin="203,94,0,0" Click="AsHeadingMarkdown_Click" FontSize="11" FontFamily="Microsoft Sans Serif"/>

        <Button x:Name="Cancel"
        Content="Cancel export"
        Style="{StaticResource DarkButtonStyle}"
        HorizontalAlignment="Left" VerticalAlignment="Top"
        Height="50" Width="182"
        Margin="203,154,0,0" Click="Cancel_Click" FontFamily="Microsoft Sans Serif"/>
        <Label Content="Select an export format" HorizontalAlignment="Left" Height="50" Margin="25,26,0,0" VerticalAlignment="Top" Width="344" Background="{x:Null}" Foreground="#FFCFD2DC" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Microsoft Sans Serif" FontSize="22"/>
    </Grid>
</Window>
